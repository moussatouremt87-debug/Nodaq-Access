# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Replit-uploaded attachments (chat/prompt scratch files, not source)
attached_assets/

# Secrets — real environment files are never committed (CLAUDE.md §6).
# .env.example is the only tracked variant: it documents the keys with
# placeholder values and must stay in the repository.
.env
.env.*
!.env.example

# Front bundlé recopié dans le paquet API par `build.mjs` — sortie de build,
# au même titre que `dist`.
artifacts/api-server/public

# Python — `services/voice` (ticket 4.18). L'environnement est reconstruit par
# `uv sync` depuis `uv.lock`, qui LUI est versionné : c'est le pendant de
# `pnpm-lock.yaml`, et une CI qui ne le lit pas ne teste pas ce qu'on livre.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
