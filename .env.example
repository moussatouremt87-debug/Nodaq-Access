# ── LLM — Scaleway (OpenAI-compatible API) ────────────────────────────────────
# Single exit point: all model traffic (chat, vision, STT) routes through this base URL.
# No default values — the application refuses to start if any variable is absent.

LLM_BASE_URL=https://api.scaleway.ai/v1
LLM_API_KEY=<your-scaleway-api-key>

# Chat and agent completions
LLM_MODEL_CHAT=mistral/mistral-small-3.2-24b-instruct-2506:fp8

# Vision / document image extraction (same model, different config path)
LLM_MODEL_VISION=mistral/mistral-small-3.2-24b-instruct-2506:fp8

# Speech-to-text (Whisper endpoint)
LLM_MODEL_STT=openai/whisper-large-v3

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://owner:password@host/dbname
DATABASE_URL_APP=postgresql://app_user:password@host/dbname

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=<long-random-string>

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
PUBLIC_URL=https://app.yourdomain.com
NODE_ENV=production

# ── Frontend (artifacts/nodaq) ─────────────────────────────────────────────────
# Required by vite.config.ts (build and `pnpm --filter @workspace/nodaq run dev`).
# "/" in Docker (SPA served from root) and in local dev. Set to a sub-path only
# if the SPA is served behind a reverse-proxy prefix.
BASE_PATH=/

# Port of the Vite dev server. Takes precedence over PORT above, which the API
# server also reads: without it both bind the same port and the second to start
# dies with "Port 8080 is already in use". Development only — in production the
# API serves the built SPA and only PORT is used.
FRONTEND_PORT=5173

# Users are French companies — analytics period boundaries (month, quarter,
# fiscal year) are computed in this timezone. Do not change to UTC.
TZ=Europe/Paris

# ── Envoi des documents ───────────────────────────────────────────────────────
# Valeur `include:` du SPF du service d'envoi transactionnel. COMMUNE à tous les
# tenants — le sélecteur DKIM, lui, est propre à chaque domaine et se renseigne
# par tenant dans l'application.
# Sans cette variable, l'authentification de domaine ne peut pas être proposée
# et tous les tenants restent en envoi de repli.
# À relever dans la console du fournisseur : ne pas la deviner.
EMAIL_SPF_INCLUDE=include:_spf.votre-fournisseur.example

# Adresse d'expédition du mode repli (délivrabilité dégradée, avec « répondre à »
# pointant sur l'artisan).
EMAIL_REPLI_FROM=noreply@nodaq.fr

# ── Chiffrement des secrets au repos ──────────────────────────────────────────
# Clé AES-256 : 32 octets, encodés en base64. Le serveur REFUSE de démarrer sans
# elle — il n'existe aucun repli en clair, et c'est délibéré : un démarrage qui
# « fonctionne » sans clé rangerait les secrets en clair sans que personne ne le
# remarque.
#
# Engendrer une clé (ne JAMAIS réutiliser celle d'un autre environnement) :
#   openssl rand -base64 32
#
# Ce que cette clé protège : les mots de passe SMTP et les jetons de connecteurs,
# rangés chiffrés dans `tenant_secrets`. Pas les données clients.
#
# La perdre rend TOUS les secrets illisibles : ils devront être ressaisis.
ENCRYPTION_KEY=

# Clé PRÉCÉDENTE, uniquement pendant une rotation. Le déchiffrement essaie la
# clé courante puis celle-ci, ce qui évite une coupure pendant que
# `node lib/db/scripts/rotate-encryption-key.mjs` tourne. À retirer une fois la
# rotation terminée — la garder indéfiniment revient à ne pas avoir tourné.
#
# Les deux clés doivent DIFFÉRER : le démarrage échoue sinon, parce qu'une
# rotation vers la même clé ne fait rien tout en ayant l'air d'avoir réussi.
ENCRYPTION_KEY_PREVIOUS=

# ── Mandataire ────────────────────────────────────────────────────────────────
# Nombre de sauts de mandataire de confiance devant l'application, ou une valeur
# acceptée par Express (« loopback », un CIDR…). NON DÉFINI = aucune confiance :
# `req.ip` vaut l'adresse de la socket, qui ne se forge pas.
#
# Ce réglage décide de deux choses : la limitation de débit des routes publiques
# d'acceptation de devis, et `devis.accepted_ip`, qui est une preuve
# d'engagement. Sans lui, derrière un répartiteur, toutes les requêtes semblent
# venir du répartiteur — la limite devient globale et la preuve inutile.
# Le poser sans mandataire réel laisse en revanche le client choisir son
# adresse : ne le renseigner QUE si un mandataire réécrit bien l'en-tête.
TRUST_PROXY=

# ── Enrôlement automatique du domaine d'envoi ─────────────────────────────────
# Sans ces variables, l'enrôlement automatique répond 503 et l'écran continue de
# proposer la saisie manuelle du sélecteur DKIM. Ce n'est pas une panne : c'est
# le chemin qui existait avant, et il reste ouvert.
#
# URL de base de l'API du service d'envoi transactionnel. AUCUNE valeur par
# défaut, et rien d'écrit en dur dans le code : une URL de fournisseur change
# sans préavis, et un code qui la porte PARAÎT juste tout en échouant en
# production — les tests, qui simulent le transport, resteraient verts.
# À relever dans la console du fournisseur : ne pas la deviner.
TEM_BASE_URL=

# Clé d'API du service d'envoi. C'est un identifiant de SERVICE, commun à tous
# les tenants — au même titre que LLM_API_KEY. Elle n'a rien à faire dans
# `tenant_secrets`, qui range ce qui appartient à UN tenant.
# Elle ne doit apparaître dans aucun journal, même tronquée.
TEM_API_KEY=

# Identifiant de projet, si le fournisseur en exige un. Facultatif.
TEM_PROJECT_ID=

# ── Sources publiques de prospection ──────────────────────────────────────────
# Sans ces variables, AUCUNE piste de prospection n'est proposée, et l'écran dit
# pourquoi. C'est délibéré : une suggestion que l'artisan ne pourrait pas
# vérifier ne s'affiche pas. Un annuaire imaginaire ferait démarcher des
# sociétés inexistantes avec des coordonnées inventées.
#
# URL de base de l'annuaire public d'entreprises. Aucune valeur par défaut, et
# rien d'écrit en dur dans le code — même doctrine que LLM_BASE_URL.
ANNUAIRE_BASE_URL=

# Comment la source est CITÉE à l'artisan. Configurés eux aussi : les écrire en
# dur ferait mentir l'écran le jour où la source change.
ANNUAIRE_SOURCE_LABEL=
ANNUAIRE_SOURCE_URL=

# BOAMP — avis de marchés publics. Source KEYLESS (aucune clé requise, API
# DILA confirmée sans authentification) : première du dépôt dans ce cas. Même
# doctrine que ci-dessus malgré tout — pas d'URL en dur.
BOAMP_BASE_URL=
BOAMP_SOURCE_LABEL=
BOAMP_SOURCE_URL=

# DECP — attributaires de marchés publics, signal de sous-traitance. Keyless
# également. Voir l'avertissement dans lib/decp.ts : un titulaire peut être un
# entrepreneur individuel, pas seulement une société — c'est pourquoi un
# titulaire nommé reste gaté par le réglage suivant.
DECP_BASE_URL=
DECP_SOURCE_LABEL=
DECP_SOURCE_URL=
# Désactivé par défaut ("" ou absent) : sans elle, seuls des agrégats
# anonymisés sont rendus, jamais un titulaire nommé. Mettre exactement "true"
# pour l'activer — décision à assumer, pas un interrupteur anodin.
DECP_AFFICHER_TITULAIRES_PRO=

# RNIC — syndics de copropriété. Keyless a priori, mais le mécanisme d'accès
# requêtable exact et le nom du champ « type de syndic » n'ont pas pu être
# confrontés à un accès réel au moment de l'écriture du module — voir
# lib/rnic-syndics.ts.
RNIC_BASE_URL=
RNIC_SOURCE_LABEL=
RNIC_SOURCE_URL=
# Désactivé par défaut, même doctrine que DECP_AFFICHER_TITULAIRES_PRO : sans
# elle, un syndic professionnel n'est jamais nommé, seulement compté.
RNIC_AFFICHER_SYNDICS_PRO=

# ── Connecteur bancaire (Bridge, ex-Bankin') ─────────────────────────────────
# Fournisseur RETENU (contrairement aux sources ci-dessus) — voir
# lib/banque-agreee. Sans ces variables, POST /connecteurs/banque/session et
# le webhook Bridge répondent 503 ; le connecteur « Banque » reste affichable
# mais non connectable.
#
# Identité PLATEFORME (un seul compte Bridge pour tout NODAQ, jamais par
# tenant) — à relever dans le tableau de bord Bridge.
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=
# Secret du webhook applicatif Bridge (un seul webhook pour toute
# l'application — voir routes/webhooks-banque.ts), distinct du Client-Secret
# ci-dessus.
BRIDGE_WEBHOOK_SECRET=
# Secret du webhook de PAIEMENT (ticket 4.19), distinct du précédent : chez
# Bridge un webhook est déclaré par app avec son propre secret, et l'app qui
# porte « Bank payment » n'est pas forcément celle qui porte l'agrégation —
# une app sandbox ne partage rien avec la production. Absent : la route
# /webhooks/paiement répond 503. JAMAIS de repli sur le secret ci-dessus :
# accepter un webhook signé avec le mauvais secret revient à ne pas vérifier.
BRIDGE_PAYMENT_WEBHOOK_SECRET=
# ── L'app qui porte l'INITIATION DE PAIEMENT ────────────────────────────────
# Deux montages sont légitimes :
#   — « Bank payment » activé sur l'app d'agrégation ci-dessus : laisser ces
#     deux lignes VIDES, les identifiants du haut servent aussi aux liens ;
#   — une app SÉPARÉE (typiquement un bac à sable — la doc Bridge précise que
#     rien n'y est transférable vers la production) : renseigner les deux.
# Les deux vont ENSEMBLE : n'en poser qu'une lève une erreur de configuration
# plutôt que d'aller chercher la moitié manquante dans l'autre app.
#
# ATTENTION — ne JAMAIS dupliquer les lignes BRIDGE_CLIENT_ID/SECRET plus bas
# dans ce fichier pour y mettre une seconde app : selon le lecteur, c'est la
# PREMIÈRE ou la DERNIÈRE occurrence qui gagne (`source` en shell prend la
# dernière, les scripts du dépôt prennent la première). Deux valeurs sous le
# même nom, c'est une configuration qui dépend de qui la lit.
BRIDGE_PAYMENT_CLIENT_ID=
BRIDGE_PAYMENT_CLIENT_SECRET=

# Permis de construire — Sitadel, via un fournisseur tiers. CONFRONTÉ AU
# SERVICE RÉEL le 28/08/2026 (point d'accès d'essai public, sans clé).
#
# Ce qui a été vérifié :
#   — le chemin est bien `<base>/v1/permits`, comme le module le composait ;
#   — le filtre est `?dep_code=` — par DÉPARTEMENT, pas par commune. Le module
#     déduit donc le département du code postal du profil entreprise ;
#   — l'enveloppe est `{ permits: [...] }` ;
#   — les champs portent des noms de colonnes SITADEL : `num_pa`,
#     `permit_type`, `localite`, `date_reelle_autorisation`.
#
# Ce qui n'a PAS pu l'être : l'essai public ne rend aucun champ sur le
# demandeur. `denom_dem` et `cj_dem` sont ajoutés en candidats parce que ce
# sont les noms de la base ouverte, mais le schéma refuse toujours
# bruyamment ce qu'il ne reconnaît pas — le premier appel avec une vraie clé
# nommera les champs reçus s'ils diffèrent.
#
# LA CORSE N'EST PAS COUVERTE : `20xxx` ne permet pas de distinguer 2A de 2B,
# et le module refuse plutôt que d'envoyer l'artisan dans le mauvais
# département.
#
# La base OUVERTE (miroir Opendatasoft du Sitadel) ne convient pas : elle
# s'arrête au 31/12/2016. Elle identifie pourtant très correctement les
# personnes morales et anonymise les particuliers — c'est de là que viennent
# `denom_dem` et `cj_dem`.
#
# Contrairement aux trois sources ci-dessus, celle-ci EXIGE une clé. Le
# fournisseur propose un palier gratuit (500 requêtes par mois) : le prendre
# AVANT de souscrire, un seul appel réel règle les champs restants.
PERMIS_BASE_URL=
PERMIS_API_KEY=
PERMIS_SOURCE_LABEL=
PERMIS_SOURCE_URL=
# Désactivé par défaut : sans elle, aucun demandeur professionnel n'est
# présenté comme piste à contacter — seulement compté dans les informations
# affichées. Un demandeur PARTICULIER, lui, n'est JAMAIS gaté par ce réglage
# ni par aucun autre : son nom et son adresse (déjà publics sur le permis)
# restent une information, jamais une piste, quel que soit l'état de cette
# variable — voir l'avertissement de la route /prospection/permis.
PERMIS_AFFICHER_PISTES_PRO=
# ── Agent vocal sortant (ticket 4.18) ─────────────────────────────────────────
# Téléphonie : Twilio Elastic SIP Trunking, trunk `nodaq-voice-agent`.
#
# Twilio est un fournisseur AMÉRICAIN : le média voix transite par son
# infrastructure, alors que les conversations sont classées `confidentiel`.
# C'est un écart assumé et documenté — voir docs/adr/001-telephonie-twilio.md —
# et c'est précisément pourquoi tout passe par l'interface `TelephonyProvider` :
# migrer vers un opérateur français doit rester un changement d'implémentation.
# ── Compte, pour composer les appels (Media Streams) ──────────────────────
#
# L'agent passe par Twilio MEDIA STREAMS et non par le trunk SIP : l'appel est
# créé par l'API REST, puis Twilio ouvre une WebSocket vers le worker et y pousse
# du µ-law 8 kHz dans les deux sens — exactement le format que toute la chaîne
# parle déjà (transcription, synthèse, amorce). Ni pile SIP, ni serveur de média,
# ni transcodage.
#
# Ces identifiants-là sont ceux du COMPTE (tableau de bord Twilio), et non ceux
# du trunk SIP plus bas : deux mécanismes distincts, deux jeux de secrets.
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=

# URL publique en `wss://` que Twilio appellera pour l'audio. En développement,
# un tunnel (`ngrok http 8080`) suffit ; l'adresse change à chaque redémarrage,
# d'où une variable plutôt qu'une constante.
TELEPHONY_STREAM_URL=

# ── Trunk SIP (voie alternative, non utilisée par Media Streams) ───────────
#
# Conservé : c'est la voie qu'emprunterait un pontage par serveur de média
# (LiveKit) si le produit va un jour vers de l'entrant ou du multi-partie.
# Aujourd'hui, rien ne le lit.
TELEPHONY_SIP_HOST=nodaq.pstn.twilio.com
TELEPHONY_SIP_USER=nodaq-agent
# Mot de passe du credential SIP. JAMAIS commité, jamais journalisé, même
# tronqué. Un secret qui a transité par un chat est brûlé : le régénérer.
TELEPHONY_SIP_PASS=

# Numéro appelant. En développement c'est un numéro US (+1) : suffisant pour
# les tests supervisés vers les téléphones de l'équipe, et RIEN D'AUTRE. Le
# ticket l'interdit explicitement — un débiteur français rappelé depuis un +1
# ne décroche pas, et n'aurait aucune raison de faire confiance.
TELEPHONY_CALLER_ID=

# Liste blanche des numéros composables tant que l'appelant est un +1
# (ticket 4.18-bis). Format E.164, séparés par des virgules. Liste VIDE =
# AUCUN appel possible — une liste blanche qui s'ouvre quand on oublie de la
# remplir n'en est pas une. Se désarme d'elle-même dès que l'appelant n'est
# plus américain.
VOICE_TEST_NUMBERS=

# ── Plateforme d'exécution vocale — ElevenLabs Agents (ticket 4.18-bis) ────
# Depuis l'ADR 005, la plateforme exécute l'agent (transport, transcription,
# formulation, synthèse) et revient vers nos routes /relance/appel/* pour
# chaque décision. Variables ABSENTES = la planification fonctionne mais aucun
# appel n'est composé, et la réponse le dit — rien n'échoue en silence.
#
# La clé : ELEVENLABS_API_KEY est lue d'abord, VOICE_TTS_API_KEY (même compte,
# posée au lot 6) sert de repli. Jamais de valeur par défaut.
ELEVENLABS_API_KEY=
# L'agent, créé et mis à jour UNIQUEMENT par
# `node scripts/appliquer-agent-elevenlabs.mjs` — jamais au dashboard. La
# configuration versionnée vit dans voice-agent/agent.config.mjs.
ELEVENLABS_AGENT_ID=
# Le LLM qui formule les répliques de l'agent, chez ElevenLabs. Un NOM de
# modèle de LEUR énumération (leur message d'erreur la liste), jamais une
# constante dans le code — les fournisseurs déprécient avec préavis court.
# Vide : la plateforme choisit, et son défaut (gemini flash) a raté des appels
# d'outils aux évals. Recommandé : claude-haiku-4-5 (rapide, discipliné sur
# les outils, compatible Zero Retention Mode pour le passage Enterprise).
VOICE_AGENT_LLM=
# Le numéro Twilio importé dans ElevenLabs (leur identifiant, pas le numéro).
ELEVENLABS_PHONE_NUMBER_ID=
# URL PUBLIQUE https vers notre API (port 8080) : les server tools sont appelés
# PAR ElevenLabs, localhost ne veut rien dire pour eux. En développement, un
# tunnel (ngrok http 8080) — attention, c'est l'API cette fois, plus le worker.
VOICE_TOOLS_BASE_URL=
# Secret du webhook post-call, généré par la plateforme à la création du
# webhook (transcript, durée, coût). Sans lui la route répond 503 et REFUSE
# tout : un webhook sans signature accepterait des transcriptions forgées.
ELEVENLABS_WEBHOOK_SECRET=

# Reconnaissance vocale — arbitré le 19 août 2026 sur un banc en français, en
# conditions téléphoniques (µ-law 8 kHz), propre puis bruité.
#
# QUALITÉ : les cinq candidats testés (gladia, whisper-large-v3 via Scaleway,
# whisper-1, gpt-4o-transcribe, gpt-live-transcribe) ont transcrit les trois
# extraits sans une seule erreur, montants et dates compris. La qualité ne
# départage personne sur de la synthèse vocale propre.
#
# LATENCE : c'est là que tout se joue, et l'écart est celui de la FORME, pas du
# fournisseur. Mesuré entre la fin de parole et le résultat exploitable :
#   en lot, par requête HTTP ......... 1 417 ms
#   en continu, connexion permanente ..... 154 ms
# Une conversation téléphonique tolère 200 à 500 ms EN TOUT. La transcription en
# lot consomme donc le double du budget avant même que le modèle ait réfléchi.
#
# D'où le flux continu, et d'où l'ADR 004 : cette sortie ne peut pas passer par
# `lib/llm`, qui ne connaît que des requêtes ponctuelles. C'est une sortie
# déclarée du worker, qui transporte de la voix et ne formule jamais.
VOICE_STT_PROVIDER=
VOICE_STT_API_KEY=
# Modèle de transcription en continu. Il refuse toute segmentation côté serveur
# — il transcrit au fil de l'eau, la fin de tour se décide dans le pilote.
VOICE_STT_MODEL=gpt-live-transcribe

# Agent voix-à-voix, POUR COMPARAISON UNIQUEMENT (août 2026).
#
# Un modèle qui écoute et répond en audio, sans passer par du texte. Bien plus
# naturel en tour de parole — et incompatible avec tout ce qui protège cet
# agent : les gardes de `formulation.ts` vérifient un TEXTE avant qu'il soit
# prononcé (chiffre inventé, menace, tutoiement, nom du débiteur). Un modèle qui
# parle directement ne laisse rien à intercepter.
#
# S'y ajoute une seconde porte de sortie vers un modèle, ce que la règle 2
# interdit : `LLM_BASE_URL` est censée être la seule. L'adopter demanderait un
# ADR qui amende explicitement cette règle, pas une variable de plus.
#
# Nommée d'après le SERVICE et non d'après le fournisseur, comme la garde
# `llm-single-exit.test.ts` le demande — même logique que `TEM_API_KEY` pour
# l'envoi d'e-mails.
VOICE_REALTIME_API_KEY=

# Synthèse vocale : elevenlabs (ADR 002). mistral reste un repli technique.
VOICE_TTS_PROVIDER=
VOICE_TTS_API_KEY=

# URL du contrat HTTP par lequel le worker vocal interroge le noyau de décision
# (mandat, éligibilité, garde-fous). Le worker ne réimplémente AUCUNE règle
# métier : elles vivent dans `lib/shared` et sont testées là-bas.
#
# Il n'y a PAS de jeton de service à mettre ici, et c'est délibéré. Le worker
# s'authentifie avec le jeton de l'APPEL qu'il est en train de passer, frappé
# par le serveur au moment de composer et remis avec la tâche. Un jeton de
# service aurait authentifié la machine, mais le tenant serait alors venu du
# corps de la requête — ce que la règle 1 interdit. Ici le serveur lit le tenant
# depuis la ligne que le jeton désigne : le worker n'a aucun moyen d'en nommer
# un. Le jeton meurt avec l'appel.
VOICE_DECISION_API_URL=

# Synthèse vocale — ElevenLabs (ADR 002). Fournisseur AMÉRICAIN, déclaré au
# registre de souveraineté : le texte des répliques y transite, et il contient
# des données personnelles de débiteurs.
VOICE_TTS_BASE_URL=https://api.elevenlabs.io/v1
# Voix de la BIBLIOTHÈQUE STANDARD uniquement, avec droits commerciaux inclus au
# plan. Pas de « professional clone » d'un tiers sans avoir vérifié ses
# conditions de partage : une voix clonée qui appelle des débiteurs engage la
# personne qui l'a prêtée.
VOICE_TTS_VOICE_ID=
# 32 langues dont le français, sortie ulaw_8000 native (format du trunk Twilio —
# aucune conversion dans le chemin temps réel).
#
# Mesures du 2026-08-19 sur ulaw_8000, temps au PREMIER OCTET :
#   eleven_flash_v2_5 ... 505 ms (avec optimize_streaming_latency=3)
#   eleven_v3 .......... 1 139 ms, et REFUSE optimize_streaming_latency (400)
#
# Garder Flash ici. v3 sonne mieux mais ajoute 634 ms au blanc qui suit la
# phrase du débiteur, et rien ne permet de l'accélérer. Sa qualité est utilisée
# là où elle est GRATUITE : l'amorce, synthétisée une fois au démarrage puis
# rejouée depuis la mémoire (`voice/adapters/prelude_cache.py`).
VOICE_TTS_MODEL=eleven_flash_v2_5
# Zero Retention Mode : ENTERPRISE UNIQUEMENT (vérifié le 2026-08-18). Le poser
# à `true` sur un plan self-service n'accorde pas la garantie — ça ne ferait que
# la revendiquer à tort.
VOICE_TTS_ZERO_RETENTION=

# ── Suspension du second facteur (MFA) ───────────────────────────────────────
# Décision du 2026-08-21 : le produit n'étant pas en ligne, la double
# authentification est suspendue pour ne pas gêner les essais — notamment sur
# téléphone, où l'enrôlement oblige à quitter la page.
#
# INERTE EN PRODUCTION : `NODE_ENV=production` reprend le dessus quoi qu'elle
# vaille. Une bascule capable d'éteindre l'authentification forte en
# production serait l'interrupteur qu'on finit par trouver actif sur le
# serveur qui compte — par une copie de ce fichier, un modèle recopié, un
# compose repris d'ailleurs. Vérifié par `mfa-suspension.test.ts`.
#
# Seul le littéral `true` suspend : une valeur approximative laisserait une
# faute de frappe décider d'une question de sécurité.
#
# À EFFACER avant la mise en ligne.
MFA_SUSPENDU_HORS_PRODUCTION=
