# ── LLM — Scaleway (OpenAI-compatible API) ────────────────────────────────────
# Single exit point: all model traffic (chat, vision, STT) routes through this base URL.
# No default values — the application refuses to start if any variable is absent.

LLM_BASE_URL=https://api.scaleway.ai/v1
LLM_API_KEY=<your-scaleway-api-key>

# Chat and agent completions
LLM_MODEL_CHAT=mistral/mistral-small-3.2-24b-instruct-2506:fp8

# Vision / document image extraction (same model, different config path)
LLM_MODEL_VISION=mistral/mistral-small-3.2-24b-instruct-2506:fp8

# Speech-to-text (Whisper endpoint)
LLM_MODEL_STT=openai/whisper-large-v3

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://owner:password@host/dbname
DATABASE_URL_APP=postgresql://app_user:password@host/dbname

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=<long-random-string>

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
PUBLIC_URL=https://app.yourdomain.com
NODE_ENV=production

# ── Frontend (artifacts/nodaq) ─────────────────────────────────────────────────
# Required by vite.config.ts (build and `pnpm --filter @workspace/nodaq run dev`).
# "/" in Docker (SPA served from root) and in local dev. Set to a sub-path only
# if the SPA is served behind a reverse-proxy prefix.
# Note: nodaq's dev server also reads PORT above — if running the frontend and
# api-server dev servers at the same time locally, give them different PORT values.
BASE_PATH=/

# Users are French companies — analytics period boundaries (month, quarter,
# fiscal year) are computed in this timezone. Do not change to UTC.
TZ=Europe/Paris
